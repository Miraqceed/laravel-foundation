{
    "name": "miraqceed/laravel-foundation",
    "description": "どの Laravel のアプリにも要る部品（テストの守り・CSV・ログインのロック・CSP・見張り）",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "csv", "csp", "monitoring", "testing"],
    "homepage": "https://github.com/Miraqceed/laravel-foundation",
    "authors": [
        {
            "name": "MIRAQCEED"
        }
    ],
    "support": {
        "issues": "https://github.com/Miraqceed/laravel-foundation/issues",
        "source": "https://github.com/Miraqceed/laravel-foundation"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "brianium/paratest": "^7.0",
        "laravel/fortify": "^1.0",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/fortify": "ログインのロックを Fortify の認証と組み合わせるとき"
    },
    "autoload": {
        "psr-4": {
            "Miraqceed\\Foundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Miraqceed\\Foundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Miraqceed\\Foundation\\FoundationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
